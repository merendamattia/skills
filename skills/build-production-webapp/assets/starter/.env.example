APP_ENV=local
NODE_ENV=development
# Project-owned listening ports; allocate a unique sequential block and never reuse an assigned port.
FRONTEND_PORT=17420
BACKEND_PORT=17421
POSTGRES_PORT=17432
REDIS_PORT=17479
POSTGRES_DB=production_webapp
POSTGRES_USER=production_webapp
POSTGRES_PASSWORD=production_webapp
DATABASE_URL=postgresql://production_webapp:production_webapp@localhost:17432/production_webapp
REDIS_URL=redis://localhost:17479
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:17421
PUBLIC_API_URL=http://localhost:17421
FRONTEND_URL=http://localhost:17420
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password
QUEUE_CONCURRENCY=2
WORKER_ID=local-worker-1
HEARTBEAT_INTERVAL=10000
STALE_JOB_THRESHOLD=60000
